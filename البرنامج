 import io
from datetime import datetime, timezone

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib.units import cm
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle

SEV_COLORS = {
    "critical": colors.HexColor("#ef4444"),
    "high": colors.HexColor("#f97316"),
    "medium": colors.HexColor("#eab308"),
    "low": colors.HexColor("#3b82f6"),
    "performance": colors.HexColor("#8b5cf6"),
    "code_quality": colors.HexColor("#64748b"),
}

def build_report(scan, findings) -> bytes:
    buf = io.BytesIO()
    doc = SimpleDocTemplate(buf, pagesize=A4,
                           leftMargin=2 * cm, rightMargin=2 * cm,
                           topMargin=2 * cm, bottomMargin=2 * cm)
    styles = getSampleStyleSheet()
    story = [
        Paragraph("CodeDoctor AI — Scan Report", styles["Title"]),
        Paragraph(f"Target: {scan.url or 'Source code upload'}", styles["Normal"]),
        Paragraph(f"Scan type: {scan.scan_type} | Date: "
                  f"{(scan.finished_at or datetime.now(timezone.utc)).strftime('%Y-%m-%d %H:%M UTC')}",
                  styles["Normal"]),
        Spacer(1, 12),
    ]

scores = Table([
        ["Security Score", "Quality Score", "Overall Score"],
        [f"{scan.security_score}/100", f"{scan.quality_score}/100", f"{scan.overall_score}/100"],
    ], colWidths=[5.6 * cm] * 3)
    scores.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#111827")),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
        ("ALIGN", (0, 0), (-1, -1), "CENTER"),
        ("FONTSIZE", (0, 0), (-1, -1), 12),
        ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
    ]))
    story += [scores, Spacer(1, 18),
              Paragraph("Findings (grouped by severity)", styles["Heading2"]), Spacer(1, 6)]

grouped = {}
    for f in findings:
        grouped.setdefault(f.severity, []).append(f)

for sev in ("critical", "high", "medium", "low"):
        for f in grouped.get(sev, []):
            story.append(Paragraph(
                f'<font color="{SEV_COLORS[sev].hexval()}">[{sev.upper()}]</font> '
                f"<b>{f.code}</b> — {f.location}", styles["Normal"]))
            story.append(Paragraph(f"Evidence: {f.evidence}", styles["Italic"]))
            story.append(Spacer(1, 8))

for ftype in ("performance", "code_quality"):
        for f in grouped_by_type(findings, ftype):
            story.append(Paragraph(
                f'<font color="{SEV_COLORS[ftype].hexval()}">[{ftype}]</font> '
                f"<b>{f.code}</b> — {f.location}", styles["Normal"]))
            story.append(Paragraph(f"Evidence: {f.evidence}", styles["Italic"]))
            story.append(Spacer(1, 8))

if not findings:
        story.append(Paragraph("No findings detected. Note: a clean report does not "
                               "guarantee the absence of vulnerabilities.", styles["Normal"]))
    story.append(Spacer(1, 16))
    story.append(Paragraph(
        "Disclaimer: CodeDoctor AI performs passive, non-destructive checks only. "
        "Passing these checks does not guarantee full security.",
        styles["Italic"]))
    doc.build(story)
    return buf.getvalue()

def grouped_by_type(findings, ftype):
    return [f for f in findings if f.ftype == ftype]
