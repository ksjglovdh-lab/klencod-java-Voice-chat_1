from datetime import datetime, timezone

from app.database import SessionLocal
from app.models import Scan, Finding, ScanLog
from app.scanner import fetcher, checks

SEVERITY_PENALTY = {"critical": 25, "high": 12, "medium": 6, "low": 2}

def _log(db, scan_id, message, level="info"):
    db.add(ScanLog(scan_id=scan_id, level=level, message=message))
    db.commit()

def _score(findings, ftypes, factor=1.0) -> int:
    penalty = sum(SEVERITY_PENALTY.get(f["severity"], 2)
                  for f in findings if f["type"] in ftypes)
    return max(0, min(100, int(100 - penalty * factor)))

def run_web_scan(scan_id: int, url: str):
    db = SessionLocal()
    try:
        scan = db.get(Scan, scan_id)
        scan.status, scan.error = "running", None
        db.commit()
        _log(db, scan_id, f"Fetching {url}")
        page = fetcher.fetch(url)

findings: list[dict] = []
        for check in checks.CHECKS:
            _log(db, scan_id, f"Running check: {check.__name__}")
            try:
                findings += check(url, page)
            except Exception as e:  # لا تُفشل الفحص كله بسبب فحص واحد
                _log(db, scan_id, f"{check.__name__} failed: {e}", level="warn")

_save(db, scan_id, findings)
        scan.security_score = _score(findings, {"security"})
        scan.quality_score = _score(findings, {"performance", "code_quality"}, factor=0.6)
        scan.overall_score = int(0.6 * scan.security_score + 0.4 * scan.quality_score)
        scan.status = "completed"
        scan.finished_at = datetime.now(timezone.utc)
        db.commit()
        _log(db, scan_id, f"Scan completed: {len(findings)} findings")
    except Exception as e:
        db.rollback()
        scan = db.get(Scan, scan_id)
        scan.status, scan.error = "failed", str(e)
        db.commit()
        _log(db, scan_id, f"Scan failed: {e}", level="error")
    finally:
        db.close()

def run_code_scan(scan_id: int, zip_path: str):
    from app.scanner.code_quality import analyze_zip
    db = SessionLocal()
    try:
        scan = db.get(Scan, scan_id)
        scan.status = "running"
        db.commit()
        findings = analyze_zip(zip_path)
        _save(db, scan_id, findings)
        scan.security_score = _score(findings, {"security"})
        scan.quality_score = _score(findings, {"performance", "code_quality"}, factor=0.6)
        scan.overall_score = int(0.6 * scan.security_score + 0.4 * scan.quality_score)
        scan.status = "completed"
        scan.finished_at = datetime.now(timezone.utc)
        db.commit()
    except Exception as e:
        db.rollback()
        scan = db.get(Scan, scan_id)
        scan.status, scan.error = "failed", str(e)
        db.commit()
    finally:
        db.close()

def _save(db, scan_id: int, findings: list[dict]):
    for f in findings:
        db.add(Finding(scan_id=scan_id, ftype=f["type"], severity=f["severity"],
                       code=f["code"], evidence=f["evidence"], location=f["location"]))
    db.commit()
import re
import zipfile

from app.scanner.checks import mk

TEXT_EXT = (".js", ".jsx", ".ts", ".tsx", ".css", ".html", ".py", ".json", ".env")
SECRET_PATTERNS = [
    re.compile(r"AKIA[0-9A-Z]{16}"),                      # AWS access key
    re.compile(r"-----BEGIN (RSA |EC )?PRIVATE KEY-----"),  # private key
    re.compile(r"(?i)(api[_-]?key|secret[_-]?key)\s*[:=]\s*['\"][A-Za-z0-9\-_]{16,}['\"]"),
]

def analyze_zip(zip_path: str) -> list[dict]:
    findings: list[dict] = []
    seen: set[tuple] = set()

def add_once(f):
        key = (f["code"], f["location"])
        if key not in seen:
            seen.add(key)
            findings.append(f)

with zipfile.ZipFile(zip_path) as z:
        for name in z.namelist():
            if name.endswith("/") or not name.lower().endswith(TEXT_EXT):
                continue
            try:
                content = z.read(name).decode("utf-8", errors="replace")[:500_000]
            except Exception:
                continue
            lines = content.splitlines()

if len(lines) > 1000:
                add_once(mk("LONG_FILE", "code_quality", "low",
                            f"{len(lines)} lines", name))
            for i, line in enumerate(lines, 1):
                if "eval(" in line:
                    add_once(mk("EVAL_USAGE", "security", "high", line.strip()[:120], f"{name}:{i}"))
                if "document.write(" in line:
                    add_once(mk("DOC_WRITE", "code_quality", "medium", line.strip()[:120], f"{name}:{i}"))
                if re.search(r"\.innerHTML\s*=", line):
                    add_once(mk("INNERHTML", "security", "medium", line.strip()[:120], f"{name}:{i}"))
                if re.search(r"\bTODO\b|\bFIXME\b", line):
                    add_once(mk("TODO_MARKS", "code_quality", "low", line.strip()[:120], f"{name}:{i}"))
                if re.search(r"http://(?!localhost|127\.0\.0\.1)", line):
                    add_once(mk("HTTP_URL_IN_CODE", "security", "medium", line.strip()[:120], f"{name}:{i}"))
                for pat in SECRET_PATTERNS:
                    if pat.search(line):
                        add_once(mk("HARDCODED_SECRET", "security", "critical",
                                     "Potential secret detected (value hidden)", f"{name}:{i}"))
                        break

console_hits = sum(1 for l in lines if "console.log" in l)
            if console_hits > 10:
                add_once(mk("CONSOLE_LOGS", "code_quality", "low",
                            f"{console_hits} console.log statements", name))
    return findings
