import ipaddress
import socket
import ssl
import time
from datetime import datetime, timezone
from urllib.parse import urlparse

import httpx

UA = "CodeDoctorAI/1.0 (authorized-scan; passive-checks-only)"
BLOCKED_NETWORKS = ("private", "loopback", "link_local", "reserved", "multicast")

def validate_public_url(url: str) -> str:
    p = urlparse(str(url))
    if p.scheme not in ("http", "https") or not p.hostname:
        raise ValueError("Only http(s) URLs are supported")
    try:
        infos = socket.getaddrinfo(p.hostname, None)
    except socket.gaierror:
        raise ValueError(f"Cannot resolve host: {p.hostname}")
    for info in infos:
        ip = ipaddress.ip_address(info[4][0])
        if any(getattr(ip, attr) for attr in BLOCKED_NETWORKS):
            raise ValueError(f"Blocked non-public host: {p.hostname}")
    return str(url)

def fetch(url: str, *, method: str = "GET", origin: str | None = None,
          timeout: float = 15.0, max_bytes: int = 5_000_000) -> dict:
    """طلب واحد آمن، غير تخريبي، مع قياس التوقيت. يعيد dict موحّد."""
    url = validate_public_url(url)
    headers = {"User-Agent": UA}
    if origin:
        headers["Origin"] = origin

t0 = time.perf_counter()
    with httpx.Client(timeout=timeout, verify=True, follow_redirects=True) as client:
        with client.stream(method, url, headers=headers) as r:
            ttfb_ms = int((time.perf_counter() - t0) * 1000)
            body = b"" if method == "HEAD" else r.read()
    total_ms = int((time.perf_counter() - t0) * 1000)

if len(body) > max_bytes:
        body = body[:max_bytes]  # حد أقصى للاستجابة لتفادي سحب ملفات ضخمة
    return {
        "status": r.status_code,
        "headers": r.headers,
        "text": body.decode("utf-8", errors="replace"),
        "bytes_len": len(body),
        "ttfb_ms": ttfb_ms,
        "total_ms": total_ms,
        "final_url": str(r.url),
    }

def ssl_expiry(hostname: str) -> datetime:
    """تاريخ انتهاء شهادة SSL/TLS للموقع (قراءة سلبية فقط)."""
    ctx = ssl.create_default_context()
    with socket.create_connection((hostname, 443), timeout=10) as sock:
        with ctx.wrap_socket(sock, server_hostname=hostname) as tls:
            der = tls.getpeercert(binary_form=True)
    from cryptography import x509
    cert = x509.load_der_x509_certificate(der)
    expiry = getattr(cert, "not_valid_after_utc", None) or cert.not_valid_after
    return expiry if expiry.tzinfo else expiry.replace(tzinfo=timezone.utc)
"""فحوصات سلبية غير تخريبية. كل دالة تعيد قائمة نتائج (findings).
لإضافة فحص جديد: عرّف دالة بنفس التوقيع وأضفها إلى CHECKS."""
from datetime import datetime, timezone
from urllib.parse import urljoin, urlparse

from bs4 import BeautifulSoup

from app.config import settings
from app.scanner import fetcher

EXPECTED_HEADERS = [
    ("strict-transport-security", "MISSING_HSTS", "high"),
    ("content-security-policy", "NO_CSP", "high"),
    ("x-frame-options", "XFO_MISSING", "medium"),
    ("x-content-type-options", "XCTO_MISSING", "medium"),
    ("referrer-policy", "REFERRER_MISSING", "low"),
    ("permissions-policy", "PERMISSIONS_MISSING", "low"),
]

def mk(code, ftype, severity, evidence="", location=""):
    return {"code": code, "type": ftype, "severity": severity,
            "evidence": str(evidence)[:800], "location": str(location)[:400]}

def https_ssl_check(url: str, page: dict) -> list[dict]:
    out = []
    p = urlparse(url)
    if p.scheme != "https":
        out.append(mk("INSECURE_HTTP", "security", "critical",
                      "The site is served over plain HTTP.", url))
        return out
    try:
        expiry = fetcher.ssl_expiry(p.hostname)
        days = (expiry - datetime.now(timezone.utc)).days
        if days < 0:
            out.append(mk("SSL_EXPIRED", "security", "critical",
                          f"Certificate expired {-days} days ago.", p.hostname))
        elif days <= 30:
            out.append(mk("SSL_EXPIRING", "security", "high",
                          f"Certificate expires in {days} days.", p.hostname))
    except Exception as e:
        out.append(mk("SSL_CHECK_FAILED", "security", "low",
                      f"Could not read certificate: {e}", p.hostname))
    return out

def headers_check(url: str, page: dict) -> list[dict]:
    h, out = page["headers"], []
    for name, code, sev in EXPECTED_HEADERS:
        if not h.get(name):
            out.append(mk(code, "security", sev,
                          f"Missing header: {name}", page["final_url"]))
    if h.get("server") and any(c.isdigit() for c in h.get("server", "")):
        out.append(mk("SERVER_VERSION", "security", "low",
                      f"Server header leaks version: {h['server']}", page["final_url"]))
    if h.get("x-powered-by"):
        out.append(mk("XPOWERED_BY", "security", "low",
                      f"x-powered-by: {h['x-powered-by']}", page["final_url"]))
    return out

def cookies_check(url: str, page: dict) -> list[dict]:
    out = []
    for raw in page["headers"].get_list("set-cookie"):
        parts = [p.strip().lower() for p in raw.split(";")]
        name = parts[0].split("=")[0] or "cookie"
        if "secure" not in parts:
            out.append(mk("COOKIE_NO_SECURE", "security", "high", raw, name))
        if "httponly" not in parts:
            out.append(mk("COOKIE_NO_HTTPONLY", "security", "medium", raw, name))
        if not any(p.startswith("samesite") for p in parts):
            out.append(mk("COOKIE_NO_SAMESITE", "security", "low", raw, name))
    return out

def cors_check(url: str, page: dict) -> list[dict]:
    """فحص سلبي آمن لسلوك CORS عبر أصل تحقق واحد لا يوجد تطبيق حقيقي يستخدمه."""
    try:
        probe = fetcher.fetch(url, origin="https://codedoctor-probe.invalid.local")
    except Exception:
        return []
    acao = probe["headers"].get("access-control-allow-origin", "")
    acac = probe["headers"].get("access-control-allow-credentials", "")
    out = []
    if acao == "*":
        sev = "critical" if acac.lower() == "true" else "high"
        out.append(mk("CORS_WILDCARD", "security", sev,
                      "Access-Control-Allow-Origin: *", url))
    elif acao == "https://codedoctor-probe.invalid.local":
        out.append(mk("CORS_REFLECT", "security", "high",
                      "Server reflects arbitrary Origin values.", url))
    return out

def _same_site(base: str, link: str) -> bool:
    return urlparse(link).hostname == urlparse(base).hostname

def links_check(url: str, page: dict) -> list[dict]:
    soup = BeautifulSoup(page["text"], "lxml")
    seen, targets, out = set(), [], []
    for a in soup.find_all("a", href=True):
        absu = urljoin(page["final_url"], a["href"])
        if absu.startswith(("http://", "https://")) and absu not in seen \
                and _same_site(url, absu):
            seen.add(absu)
            targets.append(absu)
            if len(targets) >= settings.MAX_LINKS:
                break
    for t in targets:
        try:
            r = fetcher.fetch(t, method="HEAD", timeout=8)
            ok = r["status"] < 400
        except Exception:
            ok = False
        if not ok:
            out.append(mk("BROKEN_LINK", "security", "medium", t, t))
    return out

def assets_check(url: str, page: dict) -> list[dict]:
    soup = BeautifulSoup(page["text"], "lxml")
    urls, out = [], []
    for tag, attr in (("script", "src"), ("img", "src"), ("link", "href")):
        for el in soup.find_all(tag, **{attr: True}):
            u = urljoin(page["final_url"], el.get(attr, ""))
            if u.startswith(("http://", "https://")) and u not in urls:
                urls.append(u)
    for u in urls[: settings.MAX_ASSETS]:
        if u.endswith((".js", ".css", ".png", ".jpg", ".svg", ".webp", ".ico")):
            try:
                r = fetcher.fetch(u, method="HEAD", timeout=8)
                ok = r["status"] < 400
            except Exception:
                ok = False
            if not ok:
                out.append(mk("BROKEN_ASSET", "security", "high", u, u))
    if len(urls) > 40:
        out.append(mk("MANY_REQUESTS", "performance", "medium",
                      f"{len(urls)} asset URLs referenced on the page.", page["final_url"]))
    return out

def performance_check(url: str, page: dict) -> list[dict]:
    out = []
    if page["ttfb_ms"] > 800:
        out.append(mk("SLOW_TTFB", "performance", "medium",
                      f"Time to first byte: {page['ttfb_ms']} ms", page["final_url"]))
    if page["bytes_len"] > 1_500_000:
        out.append(mk("LARGE_PAGE", "performance", "medium",
                      f"HTML size: {page['bytes_len'] / 1_000_000:.1f} MB", page["final_url"]))
    if page["total_ms"] > 3000:
        out.append(mk("SLOW_PAGE", "performance", "medium",
                      f"Full page fetch took {page['total_ms']} ms", page["final_url"]))
    return out

